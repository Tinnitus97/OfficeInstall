<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <AssemblyName>OfficeInstall</AssemblyName>
    <RootNamespace>OfficeInstall</RootNamespace>
    <Product>OfficeInstall</Product>
    <AssemblyTitle>OfficeInstall</AssemblyTitle>
    <Version>1.3.1</Version>
    <Description>Installiert Microsoft Office ueber das Office Deployment Tool - online oder offline</Description>

    <!-- Herausgeber-Angaben. Landen in den Dateieigenschaften der EXE
         (Rechtsklick -> Eigenschaften -> Details) und in den Dialogen von
         SmartScreen und Virenscannern. Ohne sie steht dort schlicht nichts -
         eine EXE ohne Herausgeber wirkt anonym und wird strenger bewertet.

         HINWEIS: Smart App Control loest das NICHT. Das verlangt eine gueltige
         Signatur oder bekannte Reputation; Metadaten allein reichen dafuer
         nicht. Sie helfen bei SmartScreen und Heuristiken - mehr nicht.

         "Tino Quitsch" ggf. durch den Firmennamen ersetzen. -->
    <Company>Tino Quitsch</Company>
    <Authors>Tino Quitsch</Authors>
    <Copyright>Copyright (c) 2026 Tino Quitsch</Copyright>

    <!-- Fenster-Icon der EXE -->
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>

    <!-- Debug-Symbole (.pdb) nicht mit ausgeben. Betrifft auch die nativen
         PDBs von SkiaSharp/HarfBuzzSharp, die sonst im publish-Ordner landen,
         zur Laufzeit aber nicht gebraucht werden. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Diese (nur unter Linux genutzte) D-Bus-Abhaengigkeit kommt ueber
         Avalonia.Desktop transitiv herein. Wir setzen sie explizit auf die
         neueste Version 0.94.2 - deutlich ueber der fuer CVE-2026-39959 (HIGH)
         gepatchten 0.92.0, also CVE-frei. Unter Windows nicht ausgefuehrt. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.2" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <!--
    Liegt diese Projektdatei im Wurzelverzeichnis des Repositories, sammelt das
    SDK von sich aus JEDE .cs-Datei darunter ein - also auch das Testprojekt
    unter tests\. Das ergibt zwei Einstiegspunkte (Fehler CS0017) und laesst
    den Build scheitern.

    Die folgenden Zeilen nehmen diese Ordner ausdruecklich heraus. Ohne
    Repository (Projekt allein in einem Ordner) aendern sie nichts - dann gibt
    es die Ordner schlicht nicht. bin\ und obj\ schliesst das SDK selbst aus.
  -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <Compile Remove="publish/**" />
    <Compile Remove="tools/**" />
  </ItemGroup>

</Project>
